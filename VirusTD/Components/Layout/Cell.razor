<!-- sets the divs class to cell (its current type) Right now it only switches between path and buildable, I will change later-->
<div class="cell @(Data.Type == CellType.Path ? "path" : "buildable") @CheckForTower()"
     @onclick="HandleClick">
    
</div>

@code {
    //Represents a GridCell.cs in the models folder
    [Parameter] public GridCell Data { get; set; } = default!;
    //This cell component calling a method from the GridCell class
    [Parameter] public EventCallback<GridCell> OnCellClicked { get; set; }

    private Task HandleClick() => OnCellClicked.InvokeAsync(Data);

    private string CheckForTower()
    {

        if (Data.Type == CellType.Buildable)
        {
            if (Data.Occupant != null)
            {
                return "tower";
            }
            
        }
        return "";
        
    }

}